# ==================== Distance Matrix ====================
def manhattan_distance(a, b):
    return abs(a['X'] - b['X']) + abs(a['Y'] - b['Y'])

locations = {row['ID']: (row['X'], row['Y']) for _, row in df.iterrows()}
distance_matrix = {}
for i in locations:
    distance_matrix[i] = {}
    for j in locations:
        distance_matrix[i][j] = manhattan_distance(
            {'X': locations[i][0], 'Y': locations[i][1]},
            {'X': locations[j][0], 'Y': locations[j][1]}
        )

# ==================== Enhanced TSP Solver ====================
def solve_tsp(nodes):
    if len(nodes) <= 1:
        return [], 0
    
    manager = pywrapcp.RoutingIndexManager(len(nodes), 1, 0)
    routing = pywrapcp.RoutingModel(manager)
    
    def distance_callback(from_index, to_index):
        from_node = manager.IndexToNode(from_index)
        to_node = manager.IndexToNode(to_index)
        return distance_matrix[nodes[from_node]][nodes[to_node]]
    
    transit_callback_index = routing.RegisterTransitCallback(distance_callback)
    routing.SetArcCostEvaluatorOfAllVehicles(transit_callback_index)
    
    search_parameters = pywrapcp.DefaultRoutingSearchParameters()
    search_parameters.first_solution_strategy = (
        routing_enums_pb2.FirstSolutionStrategy.PATH_CHEAPEST_ARC
    )
    search_parameters.local_search_metaheuristic = (
        routing_enums_pb2.LocalSearchMetaheuristic.GREEDY_DESCENT
    )
    search_parameters.time_limit.seconds = 1
    
    solution = routing.SolveWithParameters(search_parameters)
    
    if solution:
        index = routing.Start(0)
        route = [nodes[manager.IndexToNode(index)]]
        while not routing.IsEnd(index):
            index = solution.Value(routing.NextVar(index))
            route.append(nodes[manager.IndexToNode(index)])
        return route, solution.ObjectiveValue()
    return [], float('inf')

def get_shared_customers(zones):
    customer_zones = {}
    for zid, customers in zones.items():
        for c in customers:
            customer_zones.setdefault(c, set()).add(zid)
    return {c: list(zs) for c, zs in customer_zones.items() if len(zs) > 1}

def cluster_zoning(num_zones=3, max_zone_size=12, overlap=3):
    customer_coords = np.array([[locations[c][0], locations[c][1]] for c in locations if c != 0])
    customer_ids = [c for c in locations if c != 0]
    
    kmeans = KMeans(n_clusters=num_zones, n_init=10, random_state=42).fit(customer_coords)
    
    zones = {i+1: [] for i in range(num_zones)}
    for idx, label in enumerate(kmeans.labels_):
        zones[label+1].append(customer_ids[idx])
        
    # Post-process to ensure no zone exceeds max_zone_size
    centroids = kmeans.cluster_centers_
    for zid in list(zones.keys()):
        while len(zones[zid]) > max_zone_size:
            # Find customer to move
            farthest_customer = None
            farthest_diff = -float('inf')
            target_zid = None
            
            for c in zones[zid]:
                idx = customer_ids.index(c)
                coord = customer_coords[idx]
                dists = [np.linalg.norm(coord - centroid) for centroid in centroids]
                current_dist = dists[zid-1]
                sorted_dists = sorted(enumerate(dists), key=lambda x: x[1])
                for cluster_idx, d in sorted_dists:
                    if cluster_idx != zid-1:
                        next_dist = d
                        next_cluster = cluster_idx + 1 # Convert to 1-based zone ID
                        break
                diff = current_dist - next_dist
                if diff > farthest_diff and len(zones[next_cluster]) < max_zone_size:
                    farthest_diff = diff
                    farthest_customer = c
                    target_zid = next_cluster
                    
            if farthest_customer is not None and target_zid is not None:
                zones[zid].remove(farthest_customer)
                zones[target_zid].append(farthest_customer)
            else:
                break # Avoid infinite loop

    # Add strategic overlaps between adjacent clusters
    centroids = kmeans.cluster_centers_
    for zid in zones:
        dists = [np.linalg.norm(centroids[zid-1] - c) for i, c in enumerate(centroids)]
        sorted_zones = np.argsort(dists)
        for neighbor in sorted_zones[1:3]: # Top 2 closest neighbors
            neighbor += 1
            overlap_candidates = [c for c in zones[neighbor] if c not in zones[zid]]
            if overlap_candidates:
                n_overlap = min(overlap, len(overlap_candidates), max_zone_size - len(zones[zid]))
                if n_overlap > 0:
                    zones[zid].extend(np.random.choice(overlap_candidates, n_overlap, replace=False))
                    
    return zones
# ==================== Optimization Core ====================
def optimize_day(day, zones, shared_customers):
    active = df[df[day] == 1]['ID'].tolist()
    todays_shared = {c: shared_customers[c] for c in shared_customers if c in active}

    # Calculate zone centroids for heuristic assignment
    zone_centroids = {}
    for zid in zones:
        coords = [locations[c] for c in zones[zid] if c != 0]
        if coords:
            zone_centroids[zid] = np.mean(coords, axis=0)
        else:
            zone_centroids[zid] = (50, 50)  # Hub location

    # Greedy assignment of shared customers
    assignment = {}
    for c in todays_shared:
        min_dist = float('inf')
        best_zone = todays_shared[c][0]
        for zid in todays_shared[c]:
            centroid = zone_centroids[zid]
            dist = abs(locations[c][0] - centroid[0]) + abs(locations[c][1] - centroid[1])
            if dist < min_dist:
                min_dist = dist
                best_zone = zid
        assignment[c] = best_zone

    # Build zone assignments
    zone_customers = {1: [], 2: [], 3: []}
    for cust in active:
        if cust in assignment:
            zone_customers[assignment[cust]].append(cust)
        else:
            for zid in [1, 2, 3]:
                if cust in zones[zid]:
                    zone_customers[zid].append(cust)
                    break

    # Check capacity constraints
    if any(len(c) > 12 for c in zone_customers.values()):
        return handle_capacity_violation(zone_customers, todays_shared, active, zones)

    # Solve TSP for valid assignment
    total_cost = 0
    routes = {}
    for zid in [1, 2, 3]:
        customers = zone_customers[zid]
        if not customers:
            continue
        nodes = [0] + customers
        route, cost = solve_tsp(nodes)
        if cost == float('inf'):
            return {'cost': float('inf'), 'routes': {}}
        routes[zid] = route
        total_cost += cost

    return {'cost': total_cost, 'routes': routes}

def handle_capacity_violation(zone_customers, todays_shared, active, zones):
    shared_keys = list(todays_shared.keys())
    all_zone_choices = [todays_shared[c] for c in shared_keys]
    best = {'cost': float('inf'), 'routes': {}}

    # Limit combinations to 100 for speed
    for combo in itertools.islice(itertools.product(*all_zone_choices), 100):
        assignment = dict(zip(shared_keys, combo))
        zc = {1: [], 2: [], 3: []}

        for cust in active:
            if cust in assignment:
                zc[assignment[cust]].append(cust)
            else:
                for zid in [1, 2, 3]:
                    if cust in zones[zid]:
                        zc[zid].append(cust)
                        break
        
        if any(len(c) > 12 for c in zc.values()):
            continue
        
        total_cost = 0
        routes = {}
        for zid in [1, 2, 3]:
            customers = zc[zid]
            if not customers:
                continue
            nodes = [0] + customers
            route, cost = solve_tsp(nodes)
            if cost == float('inf'):
                break
            routes[zid] = route
            total_cost += cost
        else:
            if total_cost < best['cost']:
                best = {'cost': total_cost, 'routes': routes}
    
    return best

# ==================== Parallel Optimization ====================
def evaluate_zoning(zones):
    shared = get_shared_customers(zones)
    weekly_total = 0
    weekly_routes = {}

    for day in ['Mon', 'Tue', 'Wed', 'Thu', 'Fri']:
        result = optimize_day(day, zones, shared)
        if result['cost'] == float('inf'):
            return (None, float('inf'), None)
        weekly_total += result['cost']
        weekly_routes[day] = result
    
    return (copy.deepcopy(zones), weekly_total, copy.deepcopy(weekly_routes))

def zoning_optimization(num_trials=500):
    print(f"Starting optimization with {num_trials} trials at {datetime.now()}")
    best_zones = None
    best_cost = float('inf')
    best_routes = None

    with mp.Pool(mp.cpu_count() - 1) as pool:
        results = []
        for _ in range(num_trials):
            zones = cluster_zoning()
            results.append(pool.apply_async(evaluate_zoning, (zones,)))

        for i, res in enumerate(results):
            zones, cost, routes = res.get()
            if cost < best_cost:
                best_cost = cost
                best_zones = zones
                best_routes = routes
                print(f"New best found: {cost} at trial {i+1}")

    print(f"Optimization completed at {datetime.now()}")
    return best_zones, best_cost, best_routes

